# PostgreSQL — host port 5433 because project one occupies 5432
POSTGRES_DB=ai_workbench
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5433

# Backend — host port 8001 because project one occupies 8000
BACKEND_PORT=8001
FRONTEND_PORT=5173
DATABASE_URL=postgresql+psycopg://your_postgres_user:your_postgres_password@localhost:5433/ai_workbench

# Redis / RQ
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
RQ_QUEUES=default
RQ_MAX_RETRIES=2
RQ_RETRY_DELAYS=5,30

# Auth (JWT) — change SECRET_KEY for any real deployment
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI providers — use "fake" for local development and tests
CHAT_PROVIDER=fake
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_TIMEOUT_SECONDS=30

EMBEDDING_PROVIDER=fake
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=30
